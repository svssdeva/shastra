# Workspace-level ignores for shastra (the yolo/ checkout). Each subproject
# (yantra/, trishul/, naadi/, darshan/) also has its own .gitignore for
# stack-specific build artifacts that don't fit a workspace-wide pattern.

# Rust build output (subprojects symlink target/ to /tmp for noexec mounts;
# either way, never commit it).
**/target/
**/Cargo.lock.bak

# JS / TS build artifacts.
**/node_modules/
**/dist/
**/.astro/
**/.next/
**/.turbo/
**/.vite/
**/.cache/
**/.output/
**/.svelte-kit/
**/build/

# Bun lockfile is stack-specific — keep it scoped to subprojects; ignore
# accidental drops at the root.
/bun.lockb
/bun.lock

# Logs.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*

# Env + local secrets.
.env
.env.*
!.env.example
*.local

# Editor / IDE.
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*~

# OS noise.
.DS_Store
Thumbs.db
desktop.ini
Icon?

# Claude Code per-machine state and other agent runtimes.
.claude/
.cursor/
.aider*
.continue/
.zed/

# Coverage + profile data.
*.profraw
*.profdata
coverage/
lcov.info

# Tarballs and packed artifacts.
*.tgz
*.tar
*.tar.gz
*.zip

# ML model weights — never commit. Darshan fetches at runtime from HF + caches
# via the browser Cache API. Models in a checkout are accidents.
**/*.onnx
**/*.gguf
**/*.safetensors
**/*.bin
**/*.pt
**/*.pth

# Built WASM artifacts produced by subproject build scripts (e.g. darshan/packages/inference-core-wasm).
# Regenerate locally with `bun run build:wasm`. Source crate is checked in.
**/apps/*/public/wasm/*.wasm

# Junk that's shown up here historically.
TXT.txt
*.tmp
/stl

# Agent workflow artifacts — engineering persona + Claude-authored spec/plan docs.
# Kept on disk for local agent use; not part of the codebase.
CLAUDE.md
docs/superpowers/