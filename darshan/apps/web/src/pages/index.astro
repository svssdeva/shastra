---
import '../styles/global.css';
const title = 'Darshan · Local-first vision agent in your browser';
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{title}</title>
  <meta name="viewport" content="width=device-width" />
  <meta property="og:title" content="Darshan" />
  <meta property="og:description" content="Local-first vision agent. Drop an image, run a model in your tab, get a result. Zero cloud." />
  <style>
    main { max-width: 1280px; margin: 0 auto; padding: 0 24px; }
    section { padding: var(--spacing-section) 0; border-bottom: 1px solid var(--color-hairline); }
    section:last-of-type { border-bottom: 0; }

    .top-nav {
      display: flex; align-items: center; justify-content: space-between;
      height: 64px; padding: 0 var(--spacing-lg);
      background: var(--color-canvas); border-bottom: 1px solid var(--color-hairline);
    }
    .top-nav .wordmark {
      font-size: 18px; font-weight: 700; letter-spacing: -0.5px; color: var(--color-on-dark);
    }
    .top-nav .wordmark span { color: var(--color-accent); }
    .top-nav nav { display: flex; align-items: center; gap: var(--spacing-md); font-size: 14px; color: var(--color-muted); }
    .top-nav nav a:hover { color: var(--color-on-dark); }

    .hero {
      display: grid; grid-template-columns: 7fr 5fr;
      gap: var(--spacing-xl); align-items: center;
    }
    .hero p.lede {
      font-size: 18px; color: var(--color-body);
      margin: var(--spacing-md) 0 var(--spacing-xl); max-width: 36ch;
    }
    .hero .cta-row { display: flex; gap: var(--spacing-sm); flex-wrap: wrap; }
    .hero .eyebrow { display: inline-flex; gap: 8px; align-items: center; margin-bottom: var(--spacing-md); }

    .stats {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--spacing-xl);
      padding: var(--spacing-section) 0; border-top: 1px solid var(--color-hairline);
    }
    .stats .stat-label { color: var(--color-muted); font-size: 13px; margin-top: 8px; max-width: 22ch; }

    .pipelines-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--spacing-md); }
    .pipeline-card {
      background: var(--color-surface-card);
      border: 1px solid var(--color-hairline);
      border-radius: var(--radius-lg);
      padding: var(--spacing-xl);
    }
    .pipeline-card .caption-uppercase { margin-bottom: var(--spacing-md); color: var(--color-accent); }
    .pipeline-card h3 { font-size: 24px; line-height: 1.3; letter-spacing: -0.3px; margin-bottom: var(--spacing-xs); }
    .pipeline-card p { font-size: 14px; color: var(--color-body); margin: 0 0 var(--spacing-md); max-width: 36ch; }
    .pipeline-card .status { font-size: 12px; color: var(--color-muted); font-family: var(--font-mono); }

    .cta-band {
      background: var(--color-primary);
      color: var(--color-on-primary);
      border-radius: var(--radius-lg);
      padding: 64px;
      display: flex; justify-content: space-between; align-items: center; gap: var(--spacing-xl);
    }
    .cta-band h2 { color: var(--color-on-primary); font-size: 40px; line-height: 1.15; letter-spacing: -1.5px; max-width: 18ch; }
    .btn-on-yellow {
      background: var(--color-on-primary); color: var(--color-primary);
      border: 0; height: 48px; padding: 0 24px;
      font-size: 14px; font-weight: 600;
      border-radius: var(--radius-md); cursor: pointer;
      display: inline-flex; align-items: center; gap: 8px;
    }

    footer {
      padding: var(--spacing-xxl) 0; color: var(--color-muted); font-size: 14px;
      display: flex; justify-content: space-between; flex-wrap: wrap; gap: var(--spacing-md);
    }
    footer .wordmark { font-size: 16px; font-weight: 700; color: var(--color-on-dark); letter-spacing: -0.3px; margin-bottom: 8px; }
    footer .wordmark span { color: var(--color-accent); }

    pre.snippet { margin: 0; font-family: var(--font-mono); font-size: 13px; line-height: 1.55; color: var(--color-body-strong); white-space: pre; }

    @media (max-width: 900px) {
      .hero { grid-template-columns: 1fr; }
      .stats { grid-template-columns: 1fr; gap: var(--spacing-lg); }
      .pipelines-grid { grid-template-columns: 1fr; }
      .cta-band { flex-direction: column; align-items: flex-start; padding: 40px; }
      section { padding: var(--spacing-xxl) 0; }
    }
  </style>
</head>
<body>
  <header class="top-nav">
    <a href="/" class="wordmark">Darshan<span>.</span></a>
    <nav>
      <a href="/docs">Docs</a>
      <a href="https://github.com/svssdeva" target="_blank" rel="noopener">GitHub</a>
      <a href="/run" class="btn-primary">Open agent →</a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <div>
        <span class="eyebrow badge-pill mono">on-device · zero cloud · v0.1</span>
        <h1 class="display-xl">Vision agent in a browser tab.</h1>
        <p class="lede">
          Drop an image. A model runs on your GPU, in your tab. No upload. No cloud. The result
          renders next to the file you dropped. <em>Darśana</em> — sight, but local.
        </p>
        <div class="cta-row">
          <a href="/run" class="btn-primary">Open agent →</a>
          <a href="https://github.com/svssdeva" target="_blank" rel="noopener" class="btn-secondary">View source</a>
        </div>
      </div>
      <div class="code-window">
        <div class="chrome"><i></i><i></i><i></i><span>pipeline.ts</span></div>
<pre class="snippet"><span class="cm">// One interface. Two pipelines. Swappable backends.</span>
<span class="kw">export interface</span> <span class="ty">Pipeline</span>&lt;<span class="ty">TIn</span>, <span class="ty">TOut</span>&gt; &lbrace;
  <span class="kw">readonly</span> <span class="id">id</span>: <span class="ty">'ocr' | 'dashcam'</span>;
  <span class="id">load</span>(<span class="id">backend</span>: <span class="ty">InferenceBackend</span>): <span class="ty">Promise</span>&lt;<span class="kw">void</span>&gt;;
  <span class="id">process</span>(<span class="id">input</span>: <span class="ty">TIn</span>): <span class="ty">AsyncIterable</span>&lt;<span class="ty">TOut</span>&gt;;
  <span class="id">dispose</span>(): <span class="ty">Promise</span>&lt;<span class="kw">void</span>&gt;;
&rbrace;</pre>
      </div>
    </section>

    <section class="stats">
      <div>
        <div class="stat-display">0 servers</div>
        <div class="stat-label">Everything runs in your tab. No telemetry. No upload.</div>
      </div>
      <div>
        <div class="stat-display">2 pipelines</div>
        <div class="stat-label">Devanagari OCR + translation. Dashcam clip-extractor. Same shell.</div>
      </div>
      <div>
        <div class="stat-display">1 seam</div>
        <div class="stat-label">transformers.js today. Rust + candle WASM tomorrow. Same interface.</div>
      </div>
    </section>

    <section>
      <span class="caption-uppercase">Pipelines</span>
      <h2 class="display-md" style="margin: var(--spacing-sm) 0 var(--spacing-xl); max-width: 18ch;">
        Pick the task. The shell is the same.
      </h2>
      <div class="pipelines-grid">
        <div class="pipeline-card">
          <div class="caption-uppercase">Phase 2</div>
          <h3>Devanagari OCR + translate</h3>
          <p>Drop a handwritten manuscript page. Detect text regions, recognize characters, translate to English. All in-tab.</p>
          <div class="status">// TrOCR · NLLB · transformers.js v3</div>
        </div>
        <div class="pipeline-card">
          <div class="caption-uppercase">Phase 3</div>
          <h3>Dashcam clip-extractor</h3>
          <p>Drop driving footage. Continuous CV detects incidents — hard brakes, near-misses, lane intrusions — and auto-cuts highlight clips.</p>
          <div class="status">// YOLOv10n · onnxruntime-web · Lucas-Kanade</div>
        </div>
      </div>
    </section>

    <section>
      <div class="cta-band">
        <h2>Drop a file. Watch the model run.</h2>
        <a href="/run" class="btn-on-yellow">Open agent →</a>
      </div>
    </section>

    <footer>
      <div>
        <div class="wordmark">Darshan<span>.</span></div>
        <div>Astro · Preact · Tailwind v4 · transformers.js · Bun</div>
      </div>
      <div>
        Requires a WebGPU-capable browser. WASM fallback works everywhere.
      </div>
    </footer>
  </main>
</body>
</html>
