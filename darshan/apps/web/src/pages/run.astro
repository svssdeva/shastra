---
import '../styles/global.css';
import '@darshan/ui-kit/styles.css';
import { Shell } from '../components/Shell.tsx';

const title = 'Darshan · Run';
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{title}</title>
  <meta name="viewport" content="width=device-width" />
  <style>
    .run-nav {
      display: flex; align-items: center; justify-content: space-between;
      height: 64px; padding: 0 24px;
      background: var(--color-canvas); border-bottom: 1px solid var(--color-hairline);
    }
    .run-nav .wordmark { font-size: 18px; font-weight: 700; color: var(--color-on-dark); letter-spacing: -0.5px; }
    .run-nav .wordmark span { color: var(--color-accent); }
    .run-nav nav { display: flex; gap: 16px; font-size: 14px; color: var(--color-muted); }
    .run-nav nav a:hover { color: var(--color-on-dark); }

    .run-header {
      padding: 32px 24px 0;
      max-width: 1280px; margin: 0 auto;
    }
    .run-header h1 {
      font-size: 32px; font-weight: 700; letter-spacing: -1px;
      margin-bottom: 4px;
    }
    .run-header p { color: var(--color-muted); margin: 0; font-size: 14px; }
  </style>
</head>
<body>
  <header class="run-nav">
    <a href="/" class="wordmark">Darshan<span>.</span></a>
    <nav>
      <a href="/">← Home</a>
      <a href="/docs">Docs</a>
      <a href="https://github.com/svssdeva" target="_blank" rel="noopener">GitHub</a>
    </nav>
  </header>
  <div class="run-header">
    <h1>Run</h1>
    <p>Drop a file. The model runs in a worker, on your GPU, in this tab. Nothing leaves your machine.</p>
  </div>
  <Shell client:only="preact" />
</body>
</html>
