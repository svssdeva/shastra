# Copy to deploy/deploy-projects.env and fill in after AWS discovery.
# These are not secrets, but are environment-specific. (deploy-projects.env is gitignored.)
#
# Find them with:
#   aws --profile beyondcodekarma cloudfront list-distributions \
#     --query "DistributionList.Items[].{Id:Id,Domain:DomainName,Aliases:Aliases.Items,Origin:Origins.Items[0].DomainName}" \
#     --output table

AWS_PROFILE=beyondcodekarma
BUCKET=
DIST_ID=
