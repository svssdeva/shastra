{
  "Comment": "Least-privilege policy for the projects deploy user. Replace BUCKET and the CloudFront distribution ARN (account id + dist id) before attaching.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBucketProjectsPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BUCKET",
      "Condition": { "StringLike": { "s3:prefix": ["projects/*"] } }
    },
    {
      "Sid": "RWProjectsObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::BUCKET/projects/*"
    },
    {
      "Sid": "Invalidate",
      "Effect": "Allow",
      "Action": "cloudfront:CreateInvalidation",
      "Resource": "arn:aws:cloudfront::ACCOUNT_ID:distribution/DIST_ID"
    }
  ]
}
