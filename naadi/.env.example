# Naadi environment configuration. Copy to `.env` and edit as needed.
# `.env` is git-ignored; only this `.env.example` is tracked.

# WebSocket URL of the signaling server the web app connects to.
# Default if unset: ws://localhost:3030/ws
PUBLIC_NAADI_SIGNAL_URL=ws://localhost:3030/ws

# Port the signaling server listens on (apps/signal).
# Default if unset: 3030
PORT=3030
