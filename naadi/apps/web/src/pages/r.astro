---
import '../styles/global.css';
import NaadiRoom from '../components/NaadiRoom';

// Static page. The room ID lives in the URL fragment (/r#<32hex>), parsed
// client-side. This keeps the whole site SSG — no per-request rendering.
export const prerender = true;

const title = 'naadi · room';
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{title}</title>
  <meta name="viewport" content="width=device-width" />
  <meta name="robots" content="noindex" />
</head>
<body>
  <header class="top-nav">
    <a href="/" class="wordmark">Naadi<span>.</span></a>
    <nav>
      <a href="/docs">Docs</a>
      <span class="badge-pill font-[var(--font-mono)]" id="room-badge">room · …</span>
      <button type="button" class="btn-secondary" id="copy-link">Copy link</button>
    </nav>
  </header>

  <NaadiRoom client:only="preact" />

  <script is:inline>
    // Validate the fragment up front. Bad / missing hash → bounce to landing
    // before the Preact island even hydrates.
    (() => {
      const m = window.location.hash.match(/^#([0-9a-f]{32})$/);
      if (!m) {
        window.location.replace('/');
        return;
      }
      const room = m[1];
      const badge = document.getElementById('room-badge');
      if (badge) badge.textContent = 'room · ' + room.slice(0, 8);

      document.getElementById('copy-link')?.addEventListener('click', (e) => {
        const btn = e.currentTarget;
        navigator.clipboard.writeText(window.location.href).then(() => {
          const prev = btn.textContent;
          btn.textContent = 'Copied';
          setTimeout(() => { btn.textContent = prev; }, 1200);
        });
      });
    })();
  </script>
</body>
</html>
