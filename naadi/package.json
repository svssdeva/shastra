{
  "name": "naadi",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @naadi/web dev",
    "dev:signal": "bun --filter @naadi/signal dev",
    "build": "bun --filter '*' build",
    "test": "bun --filter '*' test",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "typescript": "^6.0.0"
  }
}
